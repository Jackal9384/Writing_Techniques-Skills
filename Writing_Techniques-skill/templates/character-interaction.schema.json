{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "创建人物交互引导数据结构校验",
  "description": "data/character-interaction.json 的结构校验——各轮询问模板（rounds）与正反例素材（examples）。",
  "version": "1.0",
  "type": "object",
  "required": ["schema_version", "rounds", "examples"],
  "properties": {
    "schema_version": { "type": "string" },
    "description": { "type": "string" },
    "rounds": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "prompt"],
        "properties": {
          "title": { "type": "string" },
          "prompt": { "type": "string" }
        }
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["wrong", "right"],
          "properties": {
            "wrong": { "type": "string" },
            "right": { "type": "string" }
          }
        }
      }
    }
  }
}
