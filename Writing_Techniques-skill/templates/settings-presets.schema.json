{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "题材分类预设",
  "description": "data/settings-presets.json 结构校验——题材 → 世界观分类树预设。模板库 V1.0。",
  "version": "1.0",
  "type": "object",
  "required": ["schema_version", "presets"],
  "properties": {
    "schema_version": { "type": "string" },
    "presets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["match", "categories"],
        "properties": {
          "match": { "type": "array", "items": { "type": "string" } },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "sub", "prompt"],
              "properties": {
                "name": { "type": "string" },
                "sub": { "type": "array", "items": { "type": "string" } },
                "prompt": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
